rules_version = '2';

// Todo acesso a este produto passa por services/api (firebase-admin, que
// ignora estas regras). Nenhum client (apps/web, src/ antigo) usa o SDK
// client-side do Firestore — confirmado por auditoria (Fase 8). Estas
// regras existem como blindagem: se algum dia um client tentar ler/
// escrever direto, é negado por padrão, em vez de depender do
// comportamento default do projeto. Ver _local-edr-policy-009.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
