# NODE_ENV: development | production
NODE_ENV=development

# PORT: porta do serviço api (Cloud Run injeta automaticamente em produção)
PORT=8080

# FIREBASE_PROJECT_ID: projeto Firebase/Firestore (compartilhado com o
# produto Lista Aí — coleções deste produto usam o prefixo mpa_)
FIREBASE_PROJECT_ID=lista-ai-f2916

# GOOGLE_APPLICATION_CREDENTIALS: caminho para o JSON de service account,
# necessário só em desenvolvimento local. Em produção (Cloud Run) as
# credenciais são injetadas automaticamente — não configurar lá.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json

# GEMINI_API_KEY: opcional. Habilita a simulação de preços via IA;
# sem ela, roda o fallback de simulação offline.
GEMINI_API_KEY=

# GEMINI_MODEL: modelo do Gemini usado na simulação (Fase 1/2 — a Fase 3
# substitui esta simulação por busca real via Duffel/Amadeus)
GEMINI_MODEL=gemini-3.5-flash

# APP_URL: URL base da aplicação (opcional, para links auto-referenciais)
APP_URL=

# INTERNAL_SCAN_TOKEN: segredo compartilhado entre services/api e
# services/generator (Fase 4) — autentica a rota de serviço-a-serviço
# POST /internal/scan/:id, chamada pelo loop de polling do scheduler
# (sem usuário Firebase logado). Obrigatório no generator; opcional no
# api (mas a rota /internal/scan fica desabilitada — 503 — sem ele).
# Gere um valor aleatório com pelo menos 16 caracteres, ex.:
# openssl rand -hex 32
INTERNAL_SCAN_TOKEN=

# EMAIL_ACTION_SECRET: segredo compartilhado entre services/api e
# services/publisher (Fase 5) — assina/verifica o link de "pausar
# monitor" sem login, embutido no e-mail. Distinto do
# INTERNAL_SCAN_TOKEN. Opcional no api (a rota de pausar fica
# desabilitada — 401 sempre — sem ele); obrigatório no publisher.
# Gere um valor aleatório com pelo menos 16 caracteres, ex.:
# openssl rand -hex 32
EMAIL_ACTION_SECRET=

# PAUSE_LINK_TTL_DAYS: por quantos dias o link de "pausar monitor" do
# e-mail continua válido (padrão 30)
PAUSE_LINK_TTL_DAYS=30

# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_ID_PRO
# (Fase 6): opcionais — sem eles, /billing/checkout, /billing/portal e
# /webhooks/stripe respondem 503 em vez de derrubar o boot. Use as
# chaves de teste (sk_test_..., whsec_...) do Stripe Dashboard; nenhuma
# cobrança real acontece em modo test. Ver _local-adr-policy-003.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# --- Variáveis exclusivas do services/generator (Fase 4) ---

# API_INTERNAL_URL: URL do serviço api (produção: a URL do Cloud Run;
# desenvolvimento local: http://localhost:8080, valor padrão)
API_INTERNAL_URL=http://localhost:8080

# POLL_INTERVAL_MS: intervalo do loop de polling em milissegundos (padrão 60000)
POLL_INTERVAL_MS=60000

# MAX_CONCURRENT_SCANS: quantos scans rodam em paralelo por tick (padrão 5)
MAX_CONCURRENT_SCANS=5

# LEASE_DURATION_MS: por quanto tempo um monitor fica "travado" para outras
# instâncias do generator enquanto é escaneado (padrão 120000 = 2 min)
LEASE_DURATION_MS=120000

# FREE_SCAN_INTERVAL_HOURS / PRO_SCAN_INTERVAL_HOURS: frequência de
# varredura por plano (padrão: free 6h, pro 1h) — deve espelhar
# PLAN_LIMITS em packages/types (Fase 6, _local-adr-policy-003)
FREE_SCAN_INTERVAL_HOURS=6
PRO_SCAN_INTERVAL_HOURS=1

# PURGE_INTERVAL_MS: intervalo do expurgo diário de histórico de preço
# por plano (7 dias free / 90 dias pro), em milissegundos (padrão
# 86400000 = 24h). Ver _local-adr-policy-003.
PURGE_INTERVAL_MS=86400000

# --- Variáveis exclusivas do services/publisher (Fase 5) ---

# RESEND_API_KEY: opcional. Habilita o envio real de e-mail via Resend;
# sem ela, o envio é um no-op que só loga (mesmo padrão do GEMINI_API_KEY).
RESEND_API_KEY=

# EMAIL_FROM: remetente exibido nos e-mails enviados
EMAIL_FROM=FlySpot <alertas@flyspot.com.br>

# EMAIL_REPLY_TO: para onde vai a resposta se o usuário clicar em
# "Responder" — alertas@ (EMAIL_FROM) não tem caixa de entrada real.
EMAIL_REPLY_TO=contato@flyspot.com.br

# API_PUBLIC_URL: URL pública do serviço api (produção: a URL do Cloud
# Run; desenvolvimento local: http://localhost:8080, valor padrão) —
# usada para montar o link de "pausar monitor" no e-mail
API_PUBLIC_URL=http://localhost:8080

# MAX_SEND_ATTEMPTS: tentativas de envio antes de marcar o evento como
# 'failed' definitivamente (padrão 5)
MAX_SEND_ATTEMPTS=5

# SENDING_LEASE_MS: por quanto tempo um evento fica com lease 'sending'
# antes de poder ser reclamado de novo, caso o processo caia no meio do
# envio (padrão 120000 = 2 min)
SENDING_LEASE_MS=120000

# --- Variáveis exclusivas do apps/web (Fase 2 — Cloud Run, não Vercel;
# ver _local-adr-policy-001 amendment) ---

# NEXT_PUBLIC_FIREBASE_API_KEY / NEXT_PUBLIC_FIREBASE_APP_ID: config do
# Web App registrado no Firebase Console (projeto lista-ai-f2916) —
# não são secretas (rodam no navegador), mas precisam ser reais para o
# login funcionar. O Next.js embute essas variáveis no bundle em tempo
# de BUILD (--build-arg no Dockerfile), não em runtime.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=

# NEXT_PUBLIC_GOOGLE_CLIENT_ID: Client ID OAuth 2.0 (tipo Web
# application) que o Firebase já provisiona ao ativar o provedor
# Google — encontrado em Firebase Console → Authentication → Sign-in
# method → Google → "Web SDK configuration", ou em Google Cloud
# Console → APIs & Services → Credentials. Usado pelo Google Identity
# Services (não signInWithPopup/signInWithRedirect do Firebase — ver
# _local-edr-policy-008 amendment). O domínio do flyspot-web precisa
# estar em "Authorized JavaScript origins" desse client — configuração
# separada da lista de "Authorized domains" do Firebase Auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API_URL: URL do serviço api usada pelo rewrite de /api/* no
# next.config.mjs (produção: a URL do Cloud Run do flyspot-api;
# desenvolvimento local: http://localhost:8080, valor padrão)
API_URL=http://localhost:8080
