{
  "name": "monitor-de-passagens-aereas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "vite",
    "dev:api": "npm run dev --workspace=@mpa/api",
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "npm run seed --workspace=@mpa/api",
    "lint": "tsc --noEmit && npm run lint --workspace=@mpa/api"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
