{
  "name": "flyspot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "vite",
    "dev:web:next": "npm run dev --workspace=@mpa/web",
    "dev:api": "npm run dev --workspace=@mpa/api",
    "dev:generator": "npm run dev --workspace=@mpa/generator",
    "dev": "concurrently -n web,api,generator -c blue,green,yellow \"npm run dev:web:next\" \"npm run dev:api\" \"npm run dev:generator\"",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "npm run seed --workspace=@mpa/api",
    "lint": "tsc --noEmit && npm run lint --workspace=@mpa/api && npm run lint --workspace=@mpa/generator && npm run lint --workspace=@mpa/web"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
