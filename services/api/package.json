{
  "name": "@mpa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=cjs --external:@fastify/cors --external:@fastify/helmet --external:@fastify/rate-limit --external:@google/genai --external:fastify --external:firebase-admin --external:stripe --external:zod --sourcemap --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "seed": "tsx src/seed.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@google/genai": "^2.4.0",
    "@mpa/types": "*",
    "fastify": "^5.1.0",
    "firebase-admin": "^13.0.1",
    "stripe": "^22.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
